{
  "name": "dash-echartsx",
  "version": "0.1.0",
  "private": true,
  "description": "Apache ECharts components for Plotly Dash",
  "type": "module",
  "scripts": {
    "build": "npm run build:js && npm run build:py",
    "build:js": "vite build",
    "build:py": "uv run dash-generate-components ./src/lib/components dash_echartsx -p package.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react-docgen": "^7.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}