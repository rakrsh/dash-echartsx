{
  "name": "dash-echartsx",
  "version": "0.1.0",
  "private": true,
  "description": "Apache ECharts components for Plotly Dash",
  "scripts": {
    "build": "npm run build:js && npm run build:py",
    "build:js": "vite build && vite build --config vite.gl.config.ts",
    "build:py": "uv run dash-generate-components ./src/lib/components dash_echartsx -p package.json && prettier --write dash_echartsx/metadata.json",
    "lint": "eslint src mcp && prettier --check \"src/**/*.{ts,tsx}\" \"mcp/**/*.js\" vite.config.ts vite.gl.config.ts eslint.config.mjs",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "echarts": "^5.6.0 || ^6.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "echarts-gl": "^2.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.3.0",
    "react-docgen": "^7.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{dash_echartsx/utils.py,tests/**/*.py}": [
      "uv run ruff check --fix",
      "uv run black"
    ],
    "*.{json,md,mjs}": "prettier --write"
  }
}
